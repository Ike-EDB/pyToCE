{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pytoce_allocated_cc_product_schema_v1",
  "title": "pyToCE processed allocated carrying capacity product",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "readable_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": ["allocated_cc_result.yaml"],
      "properties": {
        "allocated_cc_result.yaml": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_sha256", "scientific_identity", "rows", "columns"],
      "properties": {
        "path": {"type": "string"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "scientific_identity": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty_text"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "complete",
    "allocated_cc_result",
    "allocated_cc_result_identity",
    "allocated_cc_cases",
    "lcia_method",
    "lcia_method_identity",
    "annual_impact_category_count",
    "description",
    "identity_payload",
    "method_authority_parent",
    "source_files",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "pytoce_allocated_cc_product_schema_v1"},
    "complete": {"const": true},
    "allocated_cc_result": {"$ref": "#/$defs/readable_name"},
    "allocated_cc_result_identity": {
      "type": "string",
      "pattern": "^pytoce_allocated_cc_result_schema_v1::[0-9a-f]{64}$"
    },
    "allocated_cc_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/readable_name"}
    },
    "lcia_method": {"const": ["ef31"]},
    "lcia_method_identity": {
      "type": "string",
      "pattern": "^pytoce_optimization_lcia_selection_v1::[0-9a-f]{64}$"
    },
    "annual_impact_category_count": {"type": "integer", "minimum": 1},
    "description": {"$ref": "#/$defs/nonempty_text"},
    "identity_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "allocated_cc_result",
        "description",
        "ssp_scenario",
        "lcia_method",
        "lcia_method_identity",
        "annual_table_identity",
        "cumulative_table_identity",
        "lcia_registry_identity",
        "cumulative_climate_registry_identity",
        "source_files"
      ],
      "properties": {
        "schema_version": {"const": "pytoce_allocated_cc_result_schema_v1"},
        "allocated_cc_result": {"$ref": "#/$defs/readable_name"},
        "description": {"$ref": "#/$defs/nonempty_text"},
        "ssp_scenario": {"const": "SSP2"},
        "lcia_method": {"const": ["ef31"]},
        "lcia_method_identity": {
          "type": "string",
          "pattern": "^pytoce_optimization_lcia_selection_v1::[0-9a-f]{64}$"
        },
        "annual_table_identity": {"$ref": "#/$defs/sha256"},
        "cumulative_table_identity": {"$ref": "#/$defs/sha256"},
        "lcia_registry_identity": {
          "type": "string",
          "pattern": "^pytoce_optimization_lcia_registry_v1::[0-9a-f]{64}$"
        },
        "cumulative_climate_registry_identity": {"$ref": "#/$defs/sha256"},
        "source_files": {"$ref": "#/$defs/source_files"}
      }
    },
    "method_authority_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepared_background_shared_identity",
        "prepared_background_shared_manifest_sha256",
        "prepared_lcia_authority_identity",
        "annual_lcia_registry_identity",
        "cumulative_ef_climate_registry_identity"
      ],
      "properties": {
        "prepared_background_shared_identity": {"$ref": "#/$defs/identity"},
        "prepared_background_shared_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "prepared_lcia_authority_identity": {"$ref": "#/$defs/identity"},
        "annual_lcia_registry_identity": {
          "type": "string",
          "pattern": "^pytoce_optimization_lcia_registry_v1::[0-9a-f]{64}$"
        },
        "cumulative_ef_climate_registry_identity": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_files": {"$ref": "#/$defs/source_files"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_allocated_cc.parquet",
        "cumulative_gwp100_allocated_cc.parquet",
        "lcia_method_registry.parquet",
        "cumulative_climate_method_registry.parquet"
      ],
      "properties": {
        "annual_allocated_cc.parquet": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "annual_allocated_cc.parquet"}}}
          ]
        },
        "cumulative_gwp100_allocated_cc.parquet": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "cumulative_gwp100_allocated_cc.parquet"}}}
          ]
        },
        "lcia_method_registry.parquet": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "lcia_method_registry.parquet"}}}
          ]
        },
        "cumulative_climate_method_registry.parquet": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "cumulative_climate_method_registry.parquet"}}}
          ]
        }
      }
    }
  }
}
